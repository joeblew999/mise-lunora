{
  "extraKnownMarketplaces": {
    "lunora": {
      "source": { "source": "github", "repo": "anolilab/lunora" }
    }
  },
  "enabledPlugins": { "lunora@lunora": true },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$(git rev-parse --show-toplevel)/.claude/setup-tools.sh\"", "timeout": 600 },
          { "type": "command", "command": "sh \"$(git rev-parse --show-toplevel)/.claude/install-plugin.sh\"", "timeout": 180 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "grep -q '\"stop_hook_active\": *true' && exit 0; cd \"$(git rev-parse --show-toplevel)\" && PATH=\"$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH\" mise run app:check >&2 || exit 2", "timeout": 300 }
        ]
      }
    ]
  }
}
